<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}DemihumanAI - Автоматизация и Умные Решения{% endblock %}</title>
    <meta name="description" content="{% block description %}Профессиональные Telegram боты для автоматизации задач, скачивания контента, мониторинга цен и многого другого{% endblock %}">
    <meta name="robots" content="noindex, nofollow">
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/fonts.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/main.css') }}">
    {% endblock %}
</head>
<body>
    {% block header %}
        <header class="header" id="header">
            <div class="container">
                <nav class="nav">
                    <div class="nav-brand">
                        <span class="logo-icon">🤖</span>
                        <span class="logo-text">DemihumanAI</span>
                    </div>
                    <ul class="nav-menu" id="navMenu">
                        <li><a href="#home" class="nav-link">Главная</a></li>
                        <li><a href="#bots" class="nav-link">Боты</a></li>
                        <li><a href="#demo" class="nav-link">Демо</a></li>
                        <li><a href="#faq" class="nav-link">FAQ</a></li>
                        <li><a href="#contact" class="nav-link nav-link-cta">Связаться</a></li>
                    </ul>
                    <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                </nav>
            </div>
        </header>
    {% endblock %}

    <main>
        {% block body %}{% endblock %}
    </main>

    {% block footer %}
        <footer class="footer">
            <div class="container">
                <div class="footer-content">
                    <div class="footer-section">
                        <h3 class="footer-title">DemihumanAI</h3>
                        <p class="footer-text">Создаем умные Telegram боты для автоматизации ваших задач</p>
                    </div>
                    <div class="footer-section">
                        <h4 class="footer-subtitle">Продукты</h4>
                        <ul class="footer-links">
                            <li><a href="#bots">Все боты</a></li>
                            <li><a href="#demo">Демо</a></li>
                            <li><a href="#contact">Заказать</a></li>
                        </ul>
                    </div>
                    <div class="footer-section">
                        <h4 class="footer-subtitle">Поддержка</h4>
                        <ul class="footer-links">
                            <li><a href="#faq">FAQ</a></li>
                            <li><a href="#contact">Контакты</a></li>
                            <li><a href="#">Документация</a></li>
                        </ul>
                    </div>
                    <div class="footer-section">
                        <h4 class="footer-subtitle">Контакты</h4>
                        <ul class="footer-links">
                            <li><a href="https://t.me/sir_yessir" target="_blank">Telegram</a></li>
                            <li><a href="mailto:max72rus2x2@gmail.com">Email</a></li>
                        </ul>
                    </div>
                </div>
                <div class="footer-bottom">
                    <p>&copy; {{ 'now'|date('Y') }} DemihumanAI. Все права защищены.</p>
                </div>
            </div>
        </footer>
    {% endblock %}

    {% block javascripts %}
        <script src="{{ asset('scripts/main.js') }}"></script>
    {% endblock %}
</body>
</html>
